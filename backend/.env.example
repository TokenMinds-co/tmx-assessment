# TMX HR backend configuration. Copy it and fill in the blanks:
#   cp .env.example .env
# Every variable is described in docs/configuration.md.

# --- App ---------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# The frontend dev server uses 3000, so the API defaults to 4000. In Docker,
# the compose files publish this same port on the host.
PORT=4000
# The frontend's origin, with no trailing slash. CORS allows it, and links in
# emails point to it.
FRONTEND_URL=http://localhost:3000
# Extra origins CORS should allow, comma-separated (for example a staging
# frontend). FRONTEND_URL is always allowed. Leave empty if there are none.
CORS_ORIGINS=
# Your company's name, as candidates see it in their assessment emails: the
# sender line, the subject and the name above the heading. Staff emails use the
# app's own name instead. Set NEXT_PUBLIC_COMPANY_NAME in the frontend to match.
COMPANY_NAME="TMX HR"

# --- Database: Prisma Postgres -----------------------------------------------
# Local: run `pnpm db:start` and paste the postgres:// URL it prints.
# Production: the Postgres on the VPS, reached over postgres_network, such as
#   postgresql://tmx_hr:<password>@postgres_db:5432/tmx_hr
# See docs/database.md#deployed-environments.
DATABASE_URL=

# --- Sessions ----------------------------------------------------------------
# Staff are signed out after this many days without using the app (1-30).
# Sessions also end 30 days after sign-in, however active the user is.
SESSION_TTL_DAYS=7
# Leave empty to keep the cookie on the API's own host. Set a parent domain
# (for example example.com) only if the frontend is on a sibling subdomain
# and has to see the cookie.
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API: 0 locally, 1 on the VPS behind
# its reverse proxy, so rate limits see the real client IP.
TRUST_PROXY=0

# --- Email: Resend -----------------------------------------------------------
# API key from https://resend.com/api-keys. Required in production.
# Leave it empty in development to print emails to the terminal instead.
RESEND_API_KEY=
# The sender. Its domain must be verified in Resend. onboarding@resend.dev
# works for testing, but only delivers to your own Resend account's email.
EMAIL_FROM="TMX HR <onboarding@resend.dev>"

# --- File storage ------------------------------------------------------------
# The folder for uploaded question audio and images. A relative path starts at
# the folder you run the API in. Keep it out of dist/, which every build empties.
# In Docker the compose files set it to /app/storage, a named volume.
STORAGE_DIR=./storage
