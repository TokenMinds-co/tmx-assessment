# TMX HR backend configuration. Copy it and fill in the blanks:
#   cp .env.example .env
# Every variable is described in docs/configuration.md.

# --- App ---------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# The frontend dev server uses 3000, so the API defaults to 4000.
PORT=4000
# The frontend's origin, with no trailing slash. CORS allows it, and links in
# emails point to it.
FRONTEND_URL=http://localhost:3000
# Extra origins CORS should allow, comma-separated (for example a staging
# frontend). FRONTEND_URL is always allowed. Leave empty if there are none.
CORS_ORIGINS=

# --- Database: Prisma Postgres -----------------------------------------------
# Local: run `pnpm db:start` and paste the postgres:// URL it prints.
# Cloud: Prisma Console > your database > Connect > direct connection URL.
#        Keep ?sslmode=require on the end.
DATABASE_URL=

# --- Sessions ----------------------------------------------------------------
# Staff are signed out after this many days without using the app (1-30).
# Sessions also end 30 days after sign-in, however active the user is.
SESSION_TTL_DAYS=7
# Leave empty to keep the cookie on the API's own host. Set a parent domain
# (for example tokenminds.co) only if the frontend is on a sibling subdomain
# and has to see the cookie.
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API: 0 locally, usually 1 behind a
# load balancer, so rate limits see the real client IP.
TRUST_PROXY=0

# --- Email: Resend -----------------------------------------------------------
# API key from https://resend.com/api-keys. Required in production.
# Leave it empty in development to print emails to the terminal instead.
RESEND_API_KEY=
# The sender. Its domain must be verified in Resend. onboarding@resend.dev
# works for testing, but only delivers to your own Resend account's email.
EMAIL_FROM="TMX HR <hr@tmx.center>"

# --- File storage ------------------------------------------------------------
# The folder for uploaded question audio and images. A relative path starts at
# the folder you run the API in. Keep it out of dist/, which every build empties.
STORAGE_DIR=./storage
