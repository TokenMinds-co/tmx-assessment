# TMX HR frontend configuration. Copy it and change what you need:
#   cp .env.example .env
# Every variable is described in docs/configuration.md. Only variables prefixed
# with NEXT_PUBLIC_ reach the browser, so never put a secret in one.

# The backend's origin, with no trailing slash. Next.js forwards /api/* here,
# and server components call it directly. In development it falls back to
# http://localhost:4000. Production must set it both when building (the /api
# rewrite is fixed at build time) and when running.
API_URL=http://localhost:4000

# Your company's name, as candidates see it: the page titles, the wordmark's
# alt text and the start page. Keep it the same as the backend's COMPANY_NAME,
# which names the company in their emails. Next.js inlines it at build time, so
# a change needs a rebuild, not just a restart. Defaults to TMX HR.
NEXT_PUBLIC_COMPANY_NAME=
