# TMX HR frontend configuration. Copy it and change what you need:
#   cp .env.example .env
# Every variable is described in docs/configuration.md. None of these reach
# the browser: only variables prefixed with NEXT_PUBLIC_ do.

# The backend's origin, with no trailing slash. Next.js forwards /api/* here,
# and server components call it directly. In development it falls back to
# http://localhost:4000. Production must set it both when building (the /api
# rewrite is fixed at build time) and when running.
API_URL=http://localhost:4000
